<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        DashCinema: night teal ground, cream text, orange for the active state (the colors of the
        app icon). Each service has its own color, see dashcinema_colors.xml.
    -->
    <style name="AppTheme.DashCinema">

        <item name="android:colorBackground">@color/dc_ground</item>

        <!-- Status bar-->
        <item name="colorPrimaryDark">@color/dc_ground</item>

        <!-- Tool/Nav bars -->
        <item name="colorPrimary">@color/dc_bar</item>
        <item name="colorOnPrimary">@color/dc_cream</item>
        <item name="android:textColorPrimary">@color/dc_cream</item>

        <!-- List/Media items -->
        <item name="colorSecondary">@color/dc_ground</item>
        <item name="colorOnSecondary">@color/dc_orange</item>
        <item name="android:textColorSecondary">@color/dc_cream</item>
        <item name="boxStrokeColor">@color/dc_line</item>

        <!-- Active media item -->
        <item name="alpha">1</item>
        <item name="colorSecondaryVariant">@color/dc_orange_dim</item>
        <item name="android:textColorTertiary">@color/dc_cream</item>

        <!-- Popup menu -->
        <item name="colorSurface">@color/dc_surface</item>
        <item name="colorOnSurface">@color/dc_cream</item>
        <item name="colorPrimarySurface">@color/dc_surface_high</item>
        <item name="colorOnPrimarySurface">@color/dc_cream</item>

        <item name="colorAccent">@color/dc_orange</item>
        <item name="rippleColor">@color/dc_orange_ripple</item>

        <item name="android:textColorHint">@color/dc_muted</item>

        <item name="colorControlNormal">@color/dc_muted</item>
        <item name="colorControlActivated">@color/dc_orange</item>

        <item name="cornerRadius">14dp</item>
        <item name="appSeekBarStyle">@style/AppTheme.DashCinema.SeekBarStyle</item>
        <item name="appStreamProgressStyle">@style/AppTheme.DashCinema.StreamProgressStyle</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="textAppearanceListItem">@style/TextAppearance.DashCinema.ListItem</item>
        <item name="textAppearanceCaption">@style/TextAppearance.DashCinema.Caption</item>
        <item name="textAppearanceBody1">@style/TextAppearance.DashCinema.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.DashCinema.Body2</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.DashCinema.Subtitle1</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.DashCinema.Headline6</item>
        <item name="textAppearanceButton">@style/TextAppearance.DashCinema.Button</item>
    </style>

    <style name="AppTheme.DashCinema.SeekBarStyle" parent="AppTheme.SeekBarStyle">
        <item name="android:thumbTint">@color/dc_cream</item>
        <item name="android:progressTint">@color/dc_orange</item>
        <item name="android:secondaryProgressTint">@color/dc_line</item>
    </style>

    <style name="AppTheme.DashCinema.StreamProgressStyle" parent="AppTheme.StreamProgressStyle">
        <item name="indicatorColor">@color/dc_orange</item>
        <item name="trackColor">@color/dc_surface</item>
    </style>

    <style name="TextAppearance.DashCinema.ListItem" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DashCinema.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.DashCinema.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.DashCinema.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.DashCinema.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.DashCinema.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DashCinema.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

</resources>
