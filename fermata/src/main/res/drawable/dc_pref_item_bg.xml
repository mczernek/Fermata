<?xml version="1.0" encoding="utf-8"?>
<!-- DashCinema settings row: a rounded card, the orange ripple, a cream outline when focused -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dc_orange_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dc_card" />
                    <stroke android:width="3dp" android:color="@color/dc_cream" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/dc_card" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
